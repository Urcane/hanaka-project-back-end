# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hanaka_cake
DB_USERNAME=root
DB_PASSWORD=

# JWT
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
JWT_EXPIRY=86400

# CORS
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Frontend (React) base URL — the admin panel redirects here for login/logout
FRONTEND_URL=http://localhost:5173

# Store Info
STORE_NAME="Hanaka Cake"
STORE_ADDRESS="Jl. DR. Sukono Rt 09 No 11, Karang Rejo, Balikpapan Kota, Kalimantan Timur. 76124"
STORE_HOURS="07.00 AM - 11.00 PM"
STORE_WHATSAPP=6281299998888
STORE_INSTAGRAM=hanakacake.id
# Shop coordinates — origin point for the checkout picker, the customer
# tracking map and the owner delivery map.
STORE_LAT=-1.2654
STORE_LNG=116.8312

# Owner panel — daily sales target used by the dashboard progress bar (rupiah)
SALES_TARGET_DAILY=1500000

# Midtrans (QRIS) — only the Server Key is required for the Core API charge flow
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_QRIS_ACQUIRER=gopay
